{
  "name": "coze-mini-program",
  "version": "1.0.0",
  "private": true,
  "description": "Coze Mini Program Application",
  "scripts": {
    "build": "npm run lint:build && npm run tsc && npm run build:web",
    "build:server": "cd server && npx @nestjs/cli build",
    "build:weapp": "npx weapp-tailwindcss patch && taro build --type weapp",
    "build:web": "npx weapp-tailwindcss patch || true && cross-env NODE_OPTIONS=\"--openssl-legacy-provider --max-old-space-size=4096\" taro build --type h5 --output-path dist-web",
    "dev": "concurrently -n web,server -c blue,green \"npm run dev:web\" \"npm run dev:server\"",
    "dev:server": "cd server && npx @nestjs/cli start --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:web": "taro build --type h5 --watch",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:build": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "new": "taro new",
    "preview:weapp": "taro build --type weapp --preview",
    "tsc": "npx tsc --noEmit --skipLibCheck",
    "app:build": "./build-app.sh",
    "app:sync": "pnpm build:web && npx cap sync android",
    "app:open": "npx cap open android",
    "app:run": "npx cap run android",
    "app:android": "npx cap add android",
    "app:ios": "npx cap add ios"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint"
    ]
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.1.9",
    "@tarojs/helper": "4.1.9",
    "@tarojs/plugin-framework-react": "4.1.9",
    "@tarojs/plugin-platform-h5": "4.1.9",
    "@tarojs/plugin-platform-weapp": "4.1.9",
    "@tarojs/react": "4.1.9",
    "@tarojs/runtime": "4.1.9",
    "@tarojs/shared": "4.1.9",
    "@tarojs/taro": "4.1.9",
    "drizzle-kit": "^0.31.8",
    "lucide-react": "^0.511.0",
    "lucide-react-taro": "^1.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tarojs/cli": "4.1.9",
    "@tarojs/plugin-generator": "4.1.9",
    "@tarojs/plugin-mini-ci": "^4.1.9",
    "@tarojs/vite-runner": "4.1.9",
    "@types/minimatch": "^5",
    "@types/react": "^18.0.0",
    "@vercel/node": "^5.6.6",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-preset-taro": "4.1.9",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.1.9",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "less": "^4.2.0",
    "lint-staged": "^16.1.2",
    "miniprogram-ci": "^1.9.17",
    "only-allow": "^1.2.2",
    "postcss": "^8.5.6",
    "puppeteer": "^24.37.3",
    "react-refresh": "^0.14.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4.1.18",
    "terser": "^5.30.4",
    "typescript": "^5.4.5",
    "vite": "^4.2.0",
    "weapp-tailwindcss": "^4.9.2"
  },
  "packageManager": "npm@9.0.0",
  "engines": {
    "npm": ">=9.0.0",
    "node": "20.x"
  },
  "overrides": {
    "chalk": "4.1.2",
    "ansi-styles": "4.3.0",
    "@langchain/core": {
      "chalk": "4.1.2",
      "ansi-styles": "4.3.0"
    }
  },
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Less",
    "framework": "React"
  }
}
