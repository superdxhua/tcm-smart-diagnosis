{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist-web",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.zhongyihskhealth.com/api/:path*"
    }
  ]
}
