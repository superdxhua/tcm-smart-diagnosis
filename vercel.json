{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist-web",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/tcm/:path*",
      "destination": "https://tcm-smart-diagnosis.onrender.com/api/tcm/:path*"
    },
    {
      "source": "/api/medical-ai/:path*",
      "destination": "https://tcm-smart-diagnosis.onrender.com/api/medical-ai/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tcm-smart-diagnosis.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
