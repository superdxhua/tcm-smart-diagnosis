# ================================
# 环境变量配置模板
# ================================
# 请在 Vercel Dashboard 的 Settings > Environment Variables 中配置这些变量

# ================================
# 数据库配置（Supabase）- 必需
# ================================
# 统一使用 Supabase 实例 dwswtkfbtdohaftnklxx
COZE_SUPABASE_URL=https://dwswtkfbtdohaftnklxx.supabase.co
COZE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR3c3d0a2ZidGRvaGFmdG5rbHh4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzQ0NTQ3NzMsImV4cCI6MjA1MDAzMDc3M30.5h5sL7xkMkXrXqK7pZ2nJ8mV3qR4tY5wK6bL7cN8dD0

# ================================
# Coze AI 配置（必需）
# ================================
# Coze API 访问令牌
COZE_WORKLOAD_IDENTITY_API_KEY=your_coze_api_key_here
COZE_INTEGRATION_BASE_URL=https://integration.coze.cn
COZE_INTEGRATION_MODEL_BASE_URL=https://integration.coze.cn/api/v3

# ================================
# 微信小程序配置（必需，用于微信一键登录）
# ================================
# 获取方式：微信小程序后台 > 开发管理 > 开发设置
WECHAT_APP_ID=wxc9246b2c31d037f2
WECHAT_SECRET=ca48ca8fccf44ce3e1af8c4eae102a64

# ================================
# JWT 配置（必需）
# ================================
JWT_SECRET=ad5298de0ecab1330ca2a1c00d564ccfb46767d4c174410d817d9ef3fc600e12
JWT_EXPIRES_IN=7d

# ================================
# 前端配置（Vercel 环境下必需）
# ================================
# Vercel 环境下设置为 "/"，让前端使用相对路径
PROJECT_DOMAIN=/
VITE_SUPABASE_URL=https://dwswtkfbtdohaftnklxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR3c3d0a2ZidGRvaGFmdG5rbHh4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzQ0NTQ3NzMsImV4cCI6MjA1MDAzMDc3M30.5h5sL7xkMkXrXqK7pZ2nJ8mV3qR4tY5wK6bL7cN8dD0

# ================================
# 商户收款码配置（可选）
# ================================
MERCHANT_QR_CODE=https://your-domain.com/qrcode.jpg
MERCHANT_NAME=中医智能健康

# ================================
# 微信支付配置（可选，如果使用微信支付）
# ================================
WECHAT_PAY_APP_ID=wx1234567890abcdef
WECHAT_PAY_MCH_ID=1234567890
WECHAT_PAY_API_KEY=your_32_character_api_key_here
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/payment/callback/wechat
WECHAT_PAY_API_URL=https://api.mch.weixin.qq.com

# ================================
# 对象存储配置（可选，如果使用 S3）
# ================================
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_BUCKET=your_bucket_name
STORAGE_REGION=your_region
STORAGE_ENDPOINT=your_endpoint

# ================================
# 服务器配置（Vercel 自动配置，无需手动设置）
# ================================
# PORT=3000
# NODE_ENV=production
# VERCEL=1

# ================================
# 日志配置（可选）
# ================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
