# 生产环境配置示例
# 复制此文件为 .env.production 并填写真实配置

# ==================== 数据库配置 ====================
# Supabase 或 PostgreSQL 数据库连接字符串
DATABASE_URL=postgresql://username:password@host:5432/database_name

# ==================== 对象存储配置（AWS S3 或兼容服务）====================
# AWS S3 配置
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# 或使用阿里云 OSS
# OSS_ACCESS_KEY_ID=your_oss_access_key_id
# OSS_SECRET_ACCESS_KEY=your_oss_secret_access_key
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-oss-bucket

# ==================== JWT 认证配置 ====================
# JWT 密钥（请使用强密码）
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT 过期时间（小时）
JWT_EXPIRES_IN=720

# ==================== AI 大模型配置 ====================
# 千问大模型 API（阿里云）
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 微信小程序配置 ====================
# 微信小程序 AppID
WX_APPID=your_wechat_mini_program_appid
WX_SECRET=your_wechat_mini_program_secret

# ==================== 支付配置（可选）====================
# 微信支付商户号
MCHID=your_mchid
API_V2_KEY=your_api_v2_key
API_V3_KEY=your_api_v3_key
CERT_PATH=/path/to/apiclient_cert.pem
KEY_PATH=/path/to/apiclient_key.pem
NOTIFY_URL=https://your-domain.com/api/payment/callback

# ==================== 服务配置 ====================
# 服务端口
PORT=3000

# 运行环境
NODE_ENV=production

# 项目域名（小程序 API 调用使用）
PROJECT_DOMAIN=https://your-domain.com

# ==================== 日志配置 ====================
# 日志级别：error, warn, info, debug
LOG_LEVEL=info

# ==================== 其他配置 ====================
# 允许的跨域来源
CORS_ORIGIN=https://your-domain.com

# 文件上传大小限制（MB）
MAX_FILE_SIZE=10

# 单次请求超时时间（毫秒）
TIMEOUT=30000
